{
  "name": "@fasterfixes/embed",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained <script> embed of the FasterFixes feedback widget. Bundles React and @fasterfixes/react into a single IIFE served from the app's own origin.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/embed.tsx --bundle --format=iife --minify --target=es2018 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../../apps/web/public/widget.js"
  },
  "dependencies": {
    "@fasterfixes/react": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
